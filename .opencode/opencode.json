{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-5-mini",
  "small_model": "github-copilot/gpt-5-mini",
  "provider": {
    "oxillama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OxiLLaMa (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "Qwen3-0.6B-Q4_K_M": {
          "name": "Qwen3-0.6B Q4_K_M (local)",
          "limit": {
            "context": 4096,
            "output": 4096
          }
        }
      }
    }
  },
  "autoupdate": false,
  "tui": {
    "theme": "tokyonight"
  },
  "permission": {
    "edit": "ask",
    "bash": {
      "": "ask",
      "cargo ": "allow",
      "just ": "allow",
      "jj ": "allow",
      "nix ": "allow",
      "rm ": "deny"
    },
    "read": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "skill": {
      "nushell-": "allow",
      "jj-": "allow",
      "asciidoc-": "allow",
      "just-recipe-": "allow",
      "xtask-": "allow",
      "rust-": "allow",
      "standards-": "allow",
      "git-conventions": "allow",
      "opencode-configuration": "allow",
      "skills-best-practices": "allow",
      "varlock": "allow",
      "prompt-engineering": "allow",
      "markdown": "allow",
      "skill-creator": "allow",
      "cargo-tools": "allow",
      "kani-proof": "allow",
      "nix-flake": "allow",
      "": "deny"
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "description": "Read-only planning and analysis. No file edits. No bash.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "description": "Full implementation agent. Edits and bash allowed.",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "audit": {
      "mode": "subagent",
      "description": "Standards compliance reviewer. Read-only.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "proof-review": {
      "mode": "subagent",
      "description": "Proof tier annotation review per STANDARDS.adoc §0.3.3.",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "lsp": {
    "rust-analyzer": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "nushell": {
      "command": ["nu", "--lsp"],
      "extensions": [".nu"]
    },
    "taplo": {
      "command": ["taplo", "lsp", "stdio"],
      "extensions": [".toml"]
    },
    "nixd": {
      "command": ["nixd"],
      "extensions": [".nix"]
    }
  },
  "formatter": {
    "rustfmt": {
      "command": ["rustfmt", "--edition", "2024"],
      "extensions": [".rs"]
    },
    "taplo-fmt": {
      "command": ["taplo", "format"],
      "extensions": [".toml"]
    },
    "nu-fmt": {
      "command": ["topiary", "format", "--language", "nu"],
      "extensions": [".nu"],
      "environment": {
        "TOPIARY_LANGUAGE_DIR": "{env:HOME}/.config/topiary/queries",
        "TOPIARY_CONFIG_FILE": "{env:HOME}/.config/topiary/languages.ncl"
      }
    },
    "nixfmt": {
      "command": ["nixfmt"],
      "extensions": [".nix"]
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["/bin/busybox", "sh", "-c", "unset LD_PRELOAD; exec npx -y @modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["/bin/busybox", "sh", "-c", "unset LD_PRELOAD; exec npx -y @modelcontextprotocol/server-github"],
      "enabled": false,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["/bin/busybox", "sh", "-c", "unset LD_PRELOAD; exec npx -y @modelcontextprotocol/server-filesystem /home/galloa/projects"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["/bin/busybox", "sh", "-c", "unset LD_PRELOAD; exec npx -y @modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "nushell": {
      "type": "local",
      "command": ["nu", "--mcp"],
      "enabled": true
    },
  },
  "compaction": {
    "auto": false,
    "reserved": 4000,
    "tail_turns": 20,
    "prune": false
  },
  "experimental": {
    "mcp_timeout": 10000
  },
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 8192
  }
}
