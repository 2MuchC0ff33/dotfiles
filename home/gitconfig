[core]
	compression = 9
	looseCompression = 9
	commitGraph = true
	untrackedCache = true
	indexVersion = 4
	bigFileThreshold = 52428800
	deltaBaseCacheLimit = 67108864
	# sshCommand = dbclient -i <PRIVATE_KEY_PATH> -o BatchMode=yes -o StrictHostKeyChecking=accept-new
[user]
	name = <GIT_USER_NAME>
	email = <GIT_USER_EMAIL>
	# signingkey = <GPG_SIGNING_KEY_ID>
[gpg]
	format = openpgp
	program = gpg
[commit]
	gpgsign = false
[pack]
	window = 250
	depth = 4095
	compression = 9
	threads = 1
	windowMemory = 268435456
	deltaCacheSize = 268435456
	deltaCacheLimit = 1000
	indexVersion = 2
	writeBitmaps = true
	writeBitmapHashCache = true
[repack]
	writeBitmaps = true
[fetch]
	negotiationAlgorithm = skipping
	prune = true
	pruneTags = true
	output = compact
	writeCommitGraph = true
	unpackLimit = 100
[transfer]
	fsckObjects = true
[protocol]
	version = 2
[gc]
	pruneExpire = now
	reflogExpire = 1.day.ago
	reflogExpireUnreachable = 1.day.ago
	rerereResolved = 1.day.ago
	rerereUnresolved = 1.day.ago
	packRefs = true
	auto = 6700
	autoPackLimit = 50
	autoDetach = true
	cruftPacks = false
	bigPackThreshold = 0
[maintenance]
	auto = true
	strategy = incremental
[maintenance "gc"]
	enabled = true
[maintenance "commit-graph"]
	enabled = true
	auto = 100
[maintenance "prefetch"]
	enabled = true
[maintenance "loose-objects"]
	enabled = true
	batchSize = 50000
[maintenance "incremental-repack"]
	enabled = true
