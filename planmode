#!/bin/sh
set -eu

self=$0
case "$self" in
  /*) script_path=$self ;;
  *) script_path=$(command -v -- "$self") ;;
esac
while [ -L "$script_path" ]; do
  script_path=$(ls -l "$script_path" | sed -n 's/^.* -> //p')
  case "$script_path" in
    /*) ;;
    *) script_path=$(dirname -- "$script_path")/$script_path ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd)
config_dir=${OPENCODE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/opencode}
config=${OPENCODE_CONFIG:-$config_dir/opencode.json}
tested_version=${OPENCODE_TESTED_VERSION:-2.2.7}
bin=${OPENCODE_BIN:-}

ok() { printf 'ok: %s\n' "$*"; }
warn() { printf 'warn: %s\n' "$*"; }
err() { printf 'error: %s\n' "$*" >&2; }

usage() {
  cat <<'MAN'
usage: pm [command] [options]
commands:
  install| -i|--install   Install symlinks and managed config key
  repair | -q|--repair     Re-create safe symlinks and config key
  verify  | -v|--verify     Verify files, config, and agent discovery
  upgrade-check | -x|--upgrade-check  Strict compatibility check
  status  | -s|--status     Read-only health report
  backup  | -b|--backup     Create timestamped config backup
  restore <file> | -r|--restore <file>  Restore global config from backup
  reload  | -l|--reload     Run opencode reload or print restart instruction
  uninstall | -u|--uninstall Remove managed symlinks and config key
  resolve-plan [-- <plan-id>]  Select the READY handover for this repo
  repo-profile [--emit|--apply] [--repo DIR]  Repo profile block
  cvs-migrate [--repo DIR] [--dry-run|--apply]  CVS-first migration
  help    | -h|--help       Show this help

Examples:
  pm -v
  pm -x
  pm -b
  pm -r ~/.config/opencode/opencode.json.pre-planmode.20261103T112009Z
MAN
}

resolve_bin() {
  if [ -n "$bin" ]; then return 0; fi
  if command -v opencode >/dev/null 2>&1; then bin=$(command -v opencode); return 0; fi
  bin=$HOME/.opencode/bin/opencode
  [ -x "$bin" ] || { err "opencode not found"; exit 2; }
}

lua_cmd() {
  resolve_bin
  build_dir=$root/build/planmode
  [ -f "$build_dir/planmode.luac" ] || { err "run make build first"; exit 2; }
  LUA_PATH="$build_dir/?.luac;;" lua5.4 "$build_dir/planmode.luac" "$@"
}

need_config() { [ -f "$config" ] || { err "config not found: $config"; exit 2; }; }
config_backup() {
  need_config
  backup=$config.pre-planmode.$(date -u +%Y%m%dT%H%M%SZ)
  cp -p "$config" "$backup"
  printf '%s\n' "$backup"
}

write_config_add() {
  need_config
  tmp=$config.tmp.$$
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  lua_cmd config-add "$config" "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$config"
  trap - EXIT HUP INT TERM
  ok "config updated"
}

remove_config_key() {
  need_config
  tmp=$config.tmp.$$
  trap 'rm -f "$tmp"' EXIT HUP INT TERM
  lua_cmd config-remove "$config" "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$config"
  trap - EXIT HUP INT TERM
  ok "managed config key removed"
}

issued=0
check_symlink() {
  dst=$1
  if [ -L "$dst" ]; then
    current=$(ls -l "$dst" | sed -n -f "$root/tools/sed/symlink_target.sed")
    case "$current" in
      "$root"/*) ok "$dst" ;;
      *) err "$dst points elsewhere: $current"; issued=$((issued + 1)) ;;
    esac
    return
  fi
  err "$dst is not a symlink"
  issued=$((issued + 1))
}

install_links() {
  force=$1
  if [ "$force" = 1 ]; then
    sh "$root/install.sh" --force
  else
    sh "$root/install.sh"
  fi
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case "$cmd" in
  -i|--install) cmd=install ;;
  -q|--repair) cmd=repair ;;
  -v|--verify) cmd=verify ;;
  -x|--upgrade-check) cmd=upgrade-check ;;
  -s|--status) cmd=status ;;
  -b|--backup) cmd=backup ;;
  -r|--restore) cmd=restore ;;
  -l|--reload) cmd=reload ;;
  -u|--uninstall) cmd=uninstall ;;
  -h|--help) cmd=help ;;
esac
case "$cmd" in
  help) usage; exit 0 ;;
  build) make -C "$root" build ;;
  install)
    install_links 0
    write_config_add
    "$root/planmode" verify
    ;;
  repair)
    sh "$root/install.sh"
    write_config_add
    "$root/planmode" verify
    ;;
  verify|upgrade-check)
    resolve_bin
    version=$("$bin" --version | sed -n 's/^[^ ]* //p' | sed 's/^v//')
    if [ "$version" = "$tested_version" ]; then
      ok "OpenCode version $version matches tested baseline"
    else
      if [ "$cmd" = upgrade-check ]; then
        err "OpenCode version $version differs from tested baseline $tested_version"
        exit 1
      else
        warn "OpenCode version $version differs from tested baseline $tested_version"
      fi
    fi
    if ! "$bin" debug config | grep -q '"subagent_depth"[[:space:]]*:[[:space:]]*2'; then
      err "config missing experimental.subagent_depth=2"
      exit 1
    fi
    if ! "$bin" debug agents | LUA_PATH="$root/build/planmode/?.luac;;" lua5.4 "$root/build/planmode/planmode.luac" verify-agents; then
      err "agent verification failed"
      exit 1
    fi
    lua_cmd verify-root "$root"
    lua_cmd verify-protocol "$root/agents/plan.md"
    lua_cmd verify-generic "$root"
    for path in "$root" "$root/agents" "$root/commands" "$root/skills/canonical-plan-protocol" "$root/skills/build-handover-execution"; do
      [ -e "$path" ] || err "missing $path"
    done
    check_symlink "$config_dir/AGENTS.md"
    if [ "$issued" -gt 0 ]; then exit 1; fi
    ok "$cmd passed"
    ;;
  status)
    resolve_bin
    printf 'found OpenCode: '
    "$bin" --version | sed -n 's/^[^ ]* //p' | sed 's/^v//'
    printf 'tested OpenCode: %s\n' "$tested_version"
    [ -f "$config" ] && ok "config exists" || warn "config missing"
    "$root/planmode" verify || exit 1
    ;;
  backup) config_backup ;;
  restore)
    [ $# -eq 1 ] || { err "restore requires one backup path"; exit 2; }
    [ -f "$1" ] || { err "backup missing: $1"; exit 2; }
    current=$(config_backup)
    cp -p "$1" "$config"
    ok "restored $1"
    ok "previous config preserved at $current"
    ;;
  reload)
    resolve_bin
    if "$bin" reload >/dev/null 2>&1; then ok "reload completed"; else warn "restart OpenCode"; fi
    ;;
  uninstall)
    sh "$root/install.sh" --remove
    remove_config_key
    printf 'restart OpenCode or run: ./planmode reload\n'
    ;;
  resolve-plan)
    if [ $# -gt 0 ] && [ "$1" = "--" ]; then shift; fi
    if [ $# -gt 1 ]; then
      printf 'error: at most one plan id\n' >&2
      exit 2
    fi
    plan_arg=
    if [ $# -gt 0 ]; then plan_arg=$1; fi
    repo_root=$(pwd -P)
    repo_found=0
    while true; do
      if [ -e "$repo_root/.git" ] || [ -e "$repo_root/CVS/Root" ]; then
        repo_found=1
        break
      fi
      [ "$repo_root" = "/" ] && break
      repo_root=$(dirname -- "$repo_root")
    done
    if [ "$repo_found" -eq 0 ]; then
      printf 'error: no repository root; pass an explicit plan id\n' >&2
      exit 2
    fi
    # CVS stores a CVS/Root marker in every subdirectory, so the nearest
    # marker is not the working-copy root. Climb while the parent belongs to
    # the same CVS root.
    if [ ! -e "$repo_root/.git" ] && [ -e "$repo_root/CVS/Root" ]; then
      cvs_root_id=$(sed -n '1p' "$repo_root/CVS/Root")
      while [ "$repo_root" != "/" ]; do
        parent=$(dirname -- "$repo_root")
        [ -e "$parent/CVS/Root" ] || break
        parent_id=$(sed -n '1p' "$parent/CVS/Root")
        [ "$parent_id" = "$cvs_root_id" ] || break
        repo_root=$parent
      done
    fi
    repo_name=$(basename -- "$repo_root")
    set -- "$HOME/.opencode/plan/$repo_name"/*/HANDOVER.md
    plan_dir=$(lua_cmd resolve-plan "$repo_root" "$repo_name" "$plan_arg" "$@") || exit $?
    canon=$(CDPATH= cd -- "$plan_dir" 2>/dev/null && pwd -P) || exit 5
    case "$canon" in
      "$HOME/.opencode/plan/"*) printf '%s\n' "$canon" ;;
      *) exit 5 ;;
    esac
    ;;
  repo-profile)
    lua_cmd repo-profile "$root" "$@"
    ;;
  cvs-migrate)
    sh "$root/bin/cvs-migrate" "$@"
    ;;
  *) err "unknown command: $cmd"; usage >&2; exit 2 ;;
esac
